Subject: [PATCH] privacy-core: PRIVACY_BUILD and product identity

Gork-Patch-Id: privacy-core

Gork-Invariant: privacy-build-enabled

Gork-Risk: critical
---
 crates/codegen/xai-grok-version/Cargo.toml |  8 ++-
 crates/codegen/xai-grok-version/src/lib.rs | 57 +++++++++++++++++++++-
 2 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/crates/codegen/xai-grok-version/Cargo.toml b/crates/codegen/xai-grok-version/Cargo.toml
index 20c503b0633b98a9e9fe16ef199993e1f4d6132c..79f0866d5552c71ea484ff00dbdb1aaa81269dc7 100644
--- a/crates/codegen/xai-grok-version/Cargo.toml
+++ b/crates/codegen/xai-grok-version/Cargo.toml
@@ -3,7 +3,13 @@ license = "Apache-2.0"
 name = "xai-grok-version"
 version = "1.0.38"
 edition.workspace = true
-description = "Lockstepped grok CLI version."
+description = "Lockstepped Gork Build CLI version and privacy-build constants."
+
+[features]
+# Default-on in this fork. Product crates request `features = ["privacy"]`
+# so `--no-default-features` on an unrelated crate cannot turn the switch off.
+default = ["privacy"]
+privacy = []
 
 [dependencies]
 semver = { workspace = true }
diff --git a/crates/codegen/xai-grok-version/src/lib.rs b/crates/codegen/xai-grok-version/src/lib.rs
index d78baa06c11a48083c390aa578f7094d3da0d2a3..2e9034693cf87212db8f13f316b72f7389fa5dd6 100644
--- a/crates/codegen/xai-grok-version/src/lib.rs
+++ b/crates/codegen/xai-grok-version/src/lib.rs
@@ -1,4 +1,10 @@
-//! Installed grok CLI version, kept in sync with the shipping binaries.
+//! Installed Gork Build CLI version, lockstepped with shipping binaries.
+//!
+//! **Gork Build** is a community privacy fork of xAI Grok Build (same role as
+//! VSCodium vs VS Code): same codebase, no product telemetry, no research
+//! trace uploads, no xAI branding. Model inference still uses the user's
+//! credentials against the Grok API — that is the only network path required
+//! for the agent to work.
 
 #![deny(clippy::indexing_slicing)]
 
@@ -6,6 +12,35 @@ use std::sync::OnceLock;
 
 use semver::Version;
 
+/// Compile-time privacy fork switch. Driven by the `privacy` cargo feature
+/// (default-on in this fork) rather than a patched `true` literal, so
+/// upstream version-string edits do not conflict with the policy bit.
+pub const PRIVACY_BUILD: bool = cfg!(feature = "privacy");
+
+/// User-facing product name for this fork.
+pub const PRODUCT_NAME: &str = "Gork Build";
+
+/// Preferred CLI binary / command name for this fork.
+pub const PRODUCT_CLI: &str = "gork";
+
+/// One-line positioning (README, `--version` help, welcome copy).
+pub const PRODUCT_TAGLINE: &str =
+    "VSCodium-style community build of Grok Build — vendor telemetry removed";
+
+/// `true` when research telemetry, Mixpanel, GCS session traces, and similar
+/// non-inference uploads must stay off. Always true while [`PRIVACY_BUILD`].
+#[inline]
+pub fn research_data_collection_forbidden() -> bool {
+    PRIVACY_BUILD
+}
+
+/// `true` when coding-data retention is locked to **opt-out** (no UI/API path
+/// may opt the account into sharing/training retention).
+#[inline]
+pub fn coding_data_retention_locked_opt_out() -> bool {
+    PRIVACY_BUILD
+}
+
 pub const TEST_VERSION_ENV: &str = "GROK_TEST_VERSION";
 
 pub const VERSION: &str = match option_env!("GROK_VERSION") {
@@ -58,6 +93,26 @@ pub fn display_version_with_commit(version_with_commit: &str, channel_label: &st
 mod tests {
     use super::*;
 
+    /// Gork Build privacy policy constants — compile-time hard-offs that
+    /// resolvers and updaters consult. These must stay true for this fork.
+    #[test]
+    fn privacy_build_locks_research_and_retention_policy() {
+        assert!(
+            PRIVACY_BUILD,
+            "Gork Build must ship with the `privacy` feature (PRIVACY_BUILD)"
+        );
+        assert!(
+            research_data_collection_forbidden(),
+            "research_data_collection_forbidden must follow PRIVACY_BUILD"
+        );
+        assert!(
+            coding_data_retention_locked_opt_out(),
+            "coding data retention must be locked opt-out under PRIVACY_BUILD"
+        );
+        assert_eq!(PRODUCT_CLI, "gork");
+        assert_eq!(PRODUCT_NAME, "Gork Build");
+    }
+
     /// Checks that the channel label is appended for alpha, stable, and empty labels.
     #[test]
     fn test_display_version_formatting_matrix() {

