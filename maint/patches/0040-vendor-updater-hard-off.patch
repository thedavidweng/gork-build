+#[tokio::test]
+#[serial_test::serial]
+async fn check_update_background_is_noop_under_privacy() {
+    clear_installer_test_escape_env();
+    assert!(vendor_auto_update_forbidden());
+    let cfg = dummy_update_config();
+    let bg = check_update_background(&cfg).await;
+    assert!(
+        bg.update.is_none(),
