+    pub is_override: bool,
+}
+
+pub(crate) enum PromptsModalMode {
+    Browse,
+    FilterFocused,
+    ConfirmingReset {
+        idx: usize,
+    },
+    /// In-TUI multi-line editor for one catalog entry.
+    Editing {
+        id: PromptId,
+        textarea: TextArea,
+        textarea_state: TextAreaState,
+        dirty: bool,
+        original: String,
+    },
+    /// Name a preset: new snapshot, rename, or duplicate.
+    NamingPreset {
+        editor: LineEditor,
