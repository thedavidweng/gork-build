-    assert!(!app.privacy_banner_should_show(), "already opted in");
-    app.coding_data_retention_opt_out = true;
-
-    app.is_zdr = true;
-    assert!(!app.privacy_banner_should_show(), "enterprise ZDR");
-    app.is_zdr = false;
-
